<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="R VPN" Width="1120" Height="700"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanMinimize"
        Background="{DynamicResource Surface}" Foreground="{DynamicResource Text}"
        FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" CornerRadius="18" ResizeBorderThickness="0" GlassFrameThickness="0"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource BodyFont}"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    </Style>
    <Style x:Key="MutedText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style x:Key="KeyboardFocus" TargetType="Control">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate>
            <Border CornerRadius="9" Margin="1" BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                    Opacity=".65" IsHitTestVisible="False"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ControlButton" TargetType="Button">
      <Setter Property="FontFamily" Value="{DynamicResource BodyFont}"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonSurface" CornerRadius="10" Background="{TemplateBinding Background}"
                    BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.84"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.68"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.48"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
    </Style>
    <Style x:Key="WindowButton" TargetType="Button" BasedOn="{StaticResource ControlButton}">
      <Setter Property="Width" Value="31"/><Setter Property="Height" Value="30"/>
      <Setter Property="Padding" Value="0"/><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Raised}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ServiceToggle" TargetType="ToggleButton">
      <Setter Property="Height" Value="42"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Padding="5,0">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="2" VerticalAlignment="Bottom" BorderBrush="{DynamicResource RouteDivider}" BorderThickness="{TemplateBinding BorderThickness}" IsHitTestVisible="False"/>
                <DockPanel VerticalAlignment="Center">
                  <Border Background="{DynamicResource Inset}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Width="27" Height="27" CornerRadius="7" Margin="0,0,9,0">
                    <Viewbox Width="15" Height="15"><Path x:Name="RouteIcon" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Fill="{DynamicResource Muted}"/></Viewbox>
                  </Border>
                  <TextBlock Text="{TemplateBinding Content}" Foreground="{DynamicResource Text}" FontWeight="Bold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </DockPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <TextBlock x:Name="Mode" Text="Напрямую" Style="{StaticResource MutedText}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,8,0"/>
                  <Grid Width="38" Height="21" VerticalAlignment="Center">
                    <Border x:Name="Track" CornerRadius="11" Background="{DynamicResource RouteTrackIdle}" BorderBrush="{DynamicResource Groove}" BorderThickness="1"/>
                    <Border x:Name="TrackHighlight" CornerRadius="9" Margin="1" BorderBrush="#8CFFF5BD" BorderThickness="1,1,1,0" Opacity="0"/>
                    <Ellipse x:Name="Thumb" Width="13" Height="13" Fill="{DynamicResource RouteThumbIdle}" HorizontalAlignment="Left" Margin="4,0">
                      <Ellipse.Effect><DropShadowEffect Color="#000000" ShadowDepth="1" BlurRadius="3" Opacity=".35"/></Ellipse.Effect>
                    </Ellipse>
                  </Grid>
                </StackPanel>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Raised}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Row" Property="Opacity" Value="0.56"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Mode" Property="Text" Value="Через VPN"/>
                <Setter TargetName="Mode" Property="Foreground" Value="{DynamicResource Accent}"/>
                <Setter TargetName="RouteIcon" Property="Fill" Value="{DynamicResource Accent}"/>
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource RouteTrackOn}"/>
                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource GoldLine}"/>
                <Setter TargetName="Track" Property="Effect" Value="{DynamicResource RouteGlow}"/>
                <Setter TargetName="TrackHighlight" Property="Opacity" Value="1"/>
                <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Ink}"/>
                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CodeField" TargetType="TextBox">
      <Setter Property="FontFamily" Value="{DynamicResource BodyFont}"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Background" Value="{DynamicResource Inset}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="FieldSurface" CornerRadius="10" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
              <Grid>
                <ScrollViewer x:Name="PART_ContentHost" Padding="0" VerticalAlignment="Center"/>
                <Border x:Name="FieldHint" Padding="{TemplateBinding Padding}" IsHitTestVisible="False" Visibility="Collapsed">
                  <TextBlock x:Name="FieldPlaceholder" Text="{Binding Path=(AutomationProperties.HelpText), RelativeSource={RelativeSource TemplatedParent}}"
                             Foreground="{DynamicResource Muted}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                             Margin="2,0,0,0" VerticalAlignment="Center"/>
                </Border>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="Text" Value=""/>
                  <Condition Property="IsKeyboardFocused" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="FieldHint" Property="Visibility" Value="Visible"/>
              </MultiTrigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="FieldSurface" Property="Background" Value="{DynamicResource FieldFocus}"/>
              </Trigger>
              <Trigger Property="Tag" Value="Error"><Setter TargetName="FieldSurface" Property="BorderBrush" Value="{DynamicResource Error}"/></Trigger>
              <Trigger Property="Tag" Value="Success"><Setter TargetName="FieldSurface" Property="BorderBrush" Value="{DynamicResource Teal}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PanelCard" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Panel}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Groove}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="17"/>
      <Setter Property="Effect" Value="{DynamicResource CardShadow}"/>
    </Style>
    <Style x:Key="Well" TargetType="Border" BasedOn="{StaticResource PanelCard}">
      <Setter Property="Background" Value="{DynamicResource KeyBase}"/>
      <Setter Property="Effect" Value="{x:Null}"/>
    </Style>
    <Style x:Key="EnginePulse" TargetType="Border">
      <Setter Property="CornerRadius" Value="44"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="Opacity" Value="0"/>
      <Setter Property="IsHitTestVisible" Value="False"/>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
    </Style>
    <Style x:Key="EngineFocus">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate>
            <Border Margin="-1" CornerRadius="37" BorderBrush="{DynamicResource Accent}" BorderThickness="1" Opacity=".7"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="EngineButton" TargetType="Button" BasedOn="{StaticResource ControlButton}">
      <Setter Property="FocusVisualStyle" Value="{StaticResource EngineFocus}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <ContentPresenter x:Name="EngineSurface" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="EngineSurface" Property="Opacity" Value=".85"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="EngineSurface" Property="Opacity" Value=".55"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource ControlButton}">
      <Setter Property="Height" Value="47"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="8,2"/>
      <Setter Property="Margin" Value="2,0"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style x:Key="NavText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="NavIcon" TargetType="Path">
      <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
      <Setter Property="Width" Value="17"/><Setter Property="Height" Value="17"/>
      <Setter Property="Stretch" Value="Uniform"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style x:Key="PageHeading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="34"/>
      <Setter Property="Margin" Value="0,0,0,15"/>
    </Style>
    <Style x:Key="MetricLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="MetricIcon" TargetType="Path">
      <Setter Property="Fill" Value="{DynamicResource Accent}"/>
      <Setter Property="Stretch" Value="Uniform"/>
      <Setter Property="Width" Value="15"/><Setter Property="Height" Value="15"/>
      <Setter Property="Margin" Value="0,0,5,0"/>
    </Style>
    <Style x:Key="MetricValue" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="24"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="GoldButton" TargetType="Button" BasedOn="{StaticResource ControlButton}">
      <Setter Property="Background" Value="{DynamicResource Brand}"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="RulePicker" TargetType="ComboBox">
      <Setter Property="FontFamily" Value="{DynamicResource BodyFont}"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                  <Border x:Name="ItemSurface" CornerRadius="6" Padding="{TemplateBinding Padding}" Background="Transparent">
                    <ContentPresenter/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource Panel}"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource Accent}"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{DynamicResource Inset}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="9"/>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" Margin="10,0,28,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
              <Path Data="M0,0 L4,4 8,0" Stroke="{DynamicResource Muted}" StrokeThickness="1.4" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Margin="0,0,11,0" IsHitTestVisible="False"/>
              <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True">
                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="250"
                        Padding="4" CornerRadius="9" Background="{DynamicResource Inset}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="18" Background="{DynamicResource Surface}">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid x:Name="Header" Background="{DynamicResource Inset}">
        <TextBlock Text="R VPN" Style="{StaticResource MutedText}" FontFamily="{DynamicResource WordmarkFont}" FontWeight="Bold" FontSize="12" Margin="17,0,0,0" VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0">
          <Button x:Name="ScreenshotButton" Style="{StaticResource WindowButton}" Content="&#xE722;" AutomationProperties.Name="Скопировать снимок окна"
                  ToolTip="Скопировать снимок окна · Ctrl+Shift+S"/>
          <Button x:Name="MinButton" Style="{StaticResource WindowButton}" Content="&#xE921;" AutomationProperties.Name="Свернуть"/>
          <Button x:Name="CloseButton" Style="{StaticResource WindowButton}" Content="&#xE8BB;" AutomationProperties.Name="Закрыть"/>
        </StackPanel>
        <Popup x:Name="ScreenshotResult" PlacementTarget="{Binding ElementName=ScreenshotButton}"
               Placement="Bottom" HorizontalOffset="-185" VerticalOffset="4" AllowsTransparency="True" StaysOpen="False">
          <Border CornerRadius="12" Padding="12" Width="225" Background="{DynamicResource Panel}"
                  BorderThickness="1" BorderBrush="{DynamicResource Line}">
            <StackPanel>
              <TextBlock x:Name="ScreenshotMessage" FontSize="12" TextWrapping="Wrap"/>
              <Button x:Name="SaveScreenshotButton" Style="{StaticResource GoldButton}" Content="Сохранить PNG"
                      HorizontalAlignment="Left" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>
        </Popup>
      </Grid>
      <Grid Grid.Row="1" Margin="26,0,25,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Path x:Name="HeaderLogo" Width="26" Height="26" Stretch="Uniform" Fill="{DynamicResource Accent}" Margin="0,0,8,0"/>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="Wordmark" Text="R VPN" FontFamily="{DynamicResource WordmarkFont}" FontWeight="Bold" FontSize="25" VerticalAlignment="Center"/>
            <Rectangle x:Name="WordmarkDot" Fill="{DynamicResource Accent}" Width="4" Height="4" Margin="3,0,0,6" VerticalAlignment="Bottom" IsHitTestVisible="False"/>
          </StackPanel>
          <Border x:Name="DemoBadge" CornerRadius="6" Padding="8,3" Margin="12,0,0,0" Background="{DynamicResource Inset}" VerticalAlignment="Center">
            <TextBlock Text="Демо" Style="{StaticResource MutedText}" FontSize="11"/>
          </Border>
        </StackPanel>
        <Border Style="{StaticResource Well}" Background="{DynamicResource NavWell}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="3" CornerRadius="14">
          <Grid>
            <Border x:Name="ThemeSelection" Width="40" HorizontalAlignment="Left" CornerRadius="10" Background="{DynamicResource Panel}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="1" Effect="{DynamicResource NavShadow}" IsHitTestVisible="False">
              <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
            </Border>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="DarkTheme" Style="{StaticResource ControlButton}" Width="40" Height="38" Padding="0" FontFamily="Segoe MDL2 Assets" Content="&#xE708;" AutomationProperties.Name="Тёмная тема"/>
              <Button x:Name="LightTheme" Style="{StaticResource ControlButton}" Width="40" Height="38" Padding="0" Margin="2,0,0,0" FontFamily="Segoe MDL2 Assets" Content="&#xE706;" AutomationProperties.Name="Светлая тема"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
      <Grid x:Name="HomePage" Grid.Row="2" MaxWidth="520" Margin="16,3,16,12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border x:Name="LocationCard" Style="{StaticResource PanelCard}" Padding="12,10" Margin="0,0,0,10">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="39"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid Width="30" Height="30" HorizontalAlignment="Left" VerticalAlignment="Center">
              <Grid.Clip><EllipseGeometry Center="15,15" RadiusX="15" RadiusY="15"/></Grid.Clip>
              <Rectangle Fill="White"/><Rectangle Width="6" HorizontalAlignment="Left" Margin="9,0,0,0" Fill="#155694"/>
              <Rectangle Height="6" VerticalAlignment="Center" Fill="#155694"/>
              <Grid x:Name="GermanFlag" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <Rectangle Fill="#1A1918"/><Rectangle Grid.Row="1" Fill="#D62828"/><Rectangle Grid.Row="2" Fill="#F4C430"/>
              </Grid>
            </Grid>
            <StackPanel Grid.Column="1">
              <TextBlock x:Name="LocationCountry" Text="Финляндия" FontSize="14" FontWeight="Bold"/>
              <TextBlock x:Name="LocationCity" Text="Хельсинки" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0"/>
            </StackPanel>
            <TextBlock x:Name="LocationPing" Grid.Column="2" Style="{StaticResource MutedText}" Text="0 ms" FontSize="12"
                       Margin="0,0,14,0" VerticalAlignment="Center" ToolTip="ICMP-пинг до входа R VPN"/>
            <Button x:Name="ChangeServer" Grid.Column="3" Style="{StaticResource ControlButton}" Width="142"
                    Content="Сменить сервер" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                    Background="{DynamicResource Inset}" BorderBrush="{DynamicResource Line}"
                    ToolTip="Смена сервера доступна при выключенном VPN." ToolTipService.ShowOnDisabled="True"/>
          </Grid>
        </Border>
        <StackPanel x:Name="ConnectionIntro" Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,9">
          <Border x:Name="StateBadge" HorizontalAlignment="Center" CornerRadius="8" Padding="9,5" Margin="0,0,0,4" Background="{DynamicResource Inset}">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="StateDot" Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center"/>
              <TextBlock x:Name="StatusText" Text="Отключено" FontSize="11" FontWeight="SemiBold" AutomationProperties.AutomationId="ConnectionStatus"/>
            </StackPanel>
          </Border>
          <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Center" MaxHeight="48">
            <TextBlock Text="Подключение" FontWeight="SemiBold" FontSize="38"/>
          </Viewbox>
          <TextBlock x:Name="StatusNote" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,3,0,0" TextAlignment="Center"/>
        </StackPanel>
        <Grid x:Name="Hero" Grid.Row="2">
          <Border x:Name="HeroBacking" Style="{StaticResource PanelCard}" CornerRadius="36" Background="{DynamicResource HeroBase}"/>
          <Border CornerRadius="35" Background="{DynamicResource HeroHighlight}" Margin="1" IsHitTestVisible="False"/>
          <Grid x:Name="DialMount" IsHitTestVisible="False"/>
          <Grid Width="178" Height="178" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border x:Name="KeyBase" CornerRadius="44" Background="{DynamicResource KeyBase}" BorderBrush="{DynamicResource Groove}" BorderThickness="1"/>
            <Border CornerRadius="43" Margin="1" Background="{DynamicResource KeyInset}" IsHitTestVisible="False"/>
            <Border x:Name="PulseOuter" Style="{StaticResource EnginePulse}">
              <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
            </Border>
            <Border x:Name="PulseInner" Style="{StaticResource EnginePulse}">
              <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
            </Border>
            <Button x:Name="ConnectButton" Width="128" Height="128" Padding="0" Style="{StaticResource EngineButton}" AutomationProperties.Name="Включить VPN" AutomationProperties.AutomationId="ConnectButton">
              <Border x:Name="KeyCap" Width="122" Height="122" CornerRadius="34" Background="{DynamicResource KeyIdle}" BorderBrush="{DynamicResource KeyLine}" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                <Path x:Name="ButtonLogo" Stretch="Uniform" Width="54" Height="54" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource Accent}"/>
              </Border>
            </Button>
          </Grid>
          <Grid IsHitTestVisible="False">
            <Grid.ColumnDefinitions><ColumnDefinition Width="24*"/><ColumnDefinition Width="52*"/><ColumnDefinition Width="24*"/></Grid.ColumnDefinitions>
            <Grid x:Name="MinuteDisplayMount" Width="75" Height="51" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Grid x:Name="SecondDisplayMount" Grid.Column="2" Width="75" Height="51" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <TextBlock x:Name="SessionTime" Text="00:00" Width="1" Height="1" Opacity="0" IsHitTestVisible="False"
                     AutomationProperties.Name="Время подключения 00:00"/>
        </Grid>
        <Border x:Name="MetricsCard" Grid.Row="3" Style="{StaticResource PanelCard}" Margin="0,10,0,0">
          <UniformGrid Columns="3">
            <Border Padding="12,8" BorderBrush="{DynamicResource Groove}" BorderThickness="0,0,1,0">
              <StackPanel>
                <TextBlock Text="Получено" Style="{StaticResource MetricLabel}"/>
                <StackPanel Orientation="Horizontal">
                  <Path x:Name="RxArrow" Width="12" Height="13" Stretch="Uniform" Stroke="{DynamicResource TrafficDown}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="0,0,5,0" VerticalAlignment="Center" Data="M6,1 V11 M2,7 L6,11 10,7"/>
                  <TextBlock x:Name="RxReadout" Style="{StaticResource MetricValue}">
                    <Run x:Name="RxValue" Text="0"/><Run x:Name="RxUnit" Text=" Б" FontFamily="{DynamicResource BodyFont}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Muted}"/>
                  </TextBlock>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Padding="12,8" BorderBrush="{DynamicResource Groove}" BorderThickness="0,0,1,0">
              <StackPanel>
                <TextBlock Text="Отправлено" Style="{StaticResource MetricLabel}"/>
                <StackPanel Orientation="Horizontal">
                  <Path x:Name="TxArrow" Width="12" Height="13" Stretch="Uniform" Stroke="{DynamicResource TrafficUp}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="0,0,5,0" VerticalAlignment="Center" Data="M6,11 V1 M2,5 L6,1 10,5"/>
                  <TextBlock x:Name="TxReadout" Style="{StaticResource MetricValue}">
                    <Run x:Name="TxValue" Text="0"/><Run x:Name="TxUnit" Text=" Б" FontFamily="{DynamicResource BodyFont}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Muted}"/>
                  </TextBlock>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border x:Name="EntryPingCard" Padding="12,8" ToolTip="ICMP-пинг до входа R VPN.">
              <StackPanel>
                <TextBlock Text="Пинг до входа" Style="{StaticResource MetricLabel}"/>
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="PingUnit" Text="ms" Style="{StaticResource MutedText}" FontSize="11" FontWeight="Bold"
                             Margin="0,0,5,0" VerticalAlignment="Center"/>
                  <TextBlock x:Name="PingReadout" Style="{StaticResource MetricValue}"><Run x:Name="PingValue" Text="0"/></TextBlock>
                </StackPanel>
              </StackPanel>
            </Border>
          </UniformGrid>
        </Border>
      </Grid>
      <Grid x:Name="ProfilePage" Grid.Row="2" Margin="18,4,18,10" Visibility="Collapsed">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="540" Margin="8,0">
          <TextBlock Text="Профиль" Style="{StaticResource PageHeading}"/>
          <Border Style="{StaticResource PanelCard}" Padding="16,15">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,12,0">
                <TextBlock Text="ID пользователя" Style="{StaticResource MutedText}"/>
                <TextBlock x:Name="UserIdText" Text="—" FontSize="20" FontWeight="Bold" Margin="0,5,0,0" AutomationProperties.AutomationId="UserId"/>
              </StackPanel>
              <Border Grid.Column="1" Background="{DynamicResource Line}"/>
              <StackPanel Grid.Column="2" Margin="16,0,0,0">
                <TextBlock Text="Подписка" Style="{StaticResource MutedText}"/>
                <TextBlock x:Name="AccessText" Text="Ожидает активации" FontSize="19" FontWeight="Bold" Margin="0,5,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="AccessNote" Text="30 дней с первого подключения" Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Grid>
          </Border>
          <Border Style="{StaticResource PanelCard}" Padding="15,13" Margin="0,14,0,0">
            <StackPanel>
              <TextBlock Text="Код активации" FontWeight="Bold" Margin="0,0,0,9"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="CodeInput" Style="{StaticResource CodeField}" Height="42" MaxLength="20" SpellCheck.IsEnabled="False" AutomationProperties.AutomationId="CodeInput" AutomationProperties.Name="Код активации" AutomationProperties.HelpText="XXXX-XXXX"/>
                <Button x:Name="ActivateButton" Grid.Column="2" Style="{StaticResource GoldButton}" Padding="12,0" Content="Активировать" AutomationProperties.AutomationId="ActivateButton"/>
              </Grid>
              <TextBlock x:Name="KeyFeedback" Style="{StaticResource MutedText}" Margin="0,8,0,0" MinHeight="16" TextWrapping="Wrap" AutomationProperties.AutomationId="KeyFeedback"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource PanelCard}" Padding="15,12" Margin="0,14,0,0">
            <DockPanel LastChildFill="False">
              <TextBlock Text="Трафик за период" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
              <TextBlock x:Name="UsageText" DockPanel.Dock="Right" Text="—" Style="{StaticResource MetricValue}"/>
            </DockPanel>
          </Border>
          <Border Style="{StaticResource PanelCard}" Padding="15,12" Margin="0,14,0,0">
            <StackPanel>
              <DockPanel>
                <Button x:Name="CheckUpdate" DockPanel.Dock="Right" Style="{StaticResource ControlButton}" Content="Проверить обновления"
                        BorderBrush="{DynamicResource Line}" Background="{DynamicResource Inset}" AutomationProperties.AutomationId="CheckUpdate"/>
                <TextBlock Text="Обновления" FontWeight="Bold" VerticalAlignment="Center"/>
              </DockPanel>
              <TextBlock x:Name="UpdateFeedback" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                         AutomationProperties.AutomationId="UpdateFeedback" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
          </Border>
          <TextBlock x:Name="ClientVersion" Style="{StaticResource MutedText}" HorizontalAlignment="Center"
                     Margin="0,12,0,3" AutomationProperties.AutomationId="ClientVersion"/>
        </StackPanel>
        </ScrollViewer>
      </Grid>
      <Grid x:Name="AdvancedPage" Grid.Row="2" Margin="18,4,18,10" Visibility="Collapsed">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ScrollViewer.Resources>
            <Style x:Key="RoutePageScroll" TargetType="RepeatButton">
              <Setter Property="Focusable" Value="False"/>
              <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style TargetType="ScrollBar">
              <Setter Property="Width" Value="10"/>
              <Setter Property="Focusable" Value="False"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Margin="2,2,1,2">
                      <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource RoutePageScroll}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
                      <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource RoutePageScroll}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
                      <Track.Thumb>
                        <Thumb MinHeight="20">
                          <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource Focus}" Opacity=".55" CornerRadius="4"/></ControlTemplate></Thumb.Template>
                        </Thumb>
                      </Track.Thumb>
                    </Track>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ScrollViewer.Resources>
          <StackPanel MaxWidth="540" Margin="8,0">
            <TextBlock Text="Маршруты" Style="{StaticResource PageHeading}"/>
            <Border Style="{StaticResource PanelCard}" Padding="10,5">
              <StackPanel x:Name="ServiceToggles"/>
            </Border>
            <Button x:Name="ApplyRouting" Style="{StaticResource GoldButton}" Content="Применить сейчас"
                    HorizontalAlignment="Center" Margin="0,8,0,0" Visibility="Collapsed"/>
            <TextBlock Text="Свои сайты" FontWeight="Bold" Margin="0,13,0,8"/>
            <Border Style="{StaticResource PanelCard}" Padding="10">
              <StackPanel x:Name="SiteControls">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                  <TextBox x:Name="SiteInput" Style="{StaticResource CodeField}" Height="38" MaxLength="1024" SpellCheck.IsEnabled="False" AutomationProperties.Name="Домен или ссылка" AutomationProperties.HelpText="Например, twitch.tv"/>
                  <Button x:Name="AddSite" Grid.Column="2" Style="{StaticResource GoldButton}" Padding="0" Content="+" FontSize="22" AutomationProperties.Name="Добавить сайт"/>
                </Grid>
                <TextBlock x:Name="SiteFeedback" Style="{StaticResource MutedText}" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
                <StackPanel x:Name="SiteToggles"/>
              </StackPanel>
            </Border>
            <TextBlock x:Name="RoutingNote" Style="{StaticResource MutedText}" Margin="0,10,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
          </StackPanel>
        </ScrollViewer>
      </Grid>
      <Grid x:Name="RulesPage" Grid.Row="2" Margin="26,4,26,10" MaxWidth="900" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel>
          <Button x:Name="RulesRawToggle" DockPanel.Dock="Right" Content="Дополнительно" Style="{StaticResource ControlButton}"
                  Background="{DynamicResource Inset}" BorderBrush="{DynamicResource Line}" VerticalAlignment="Top"/>
          <TextBlock Text="Правила" Style="{StaticResource PageHeading}"/>
        </DockPanel>
        <Grid x:Name="RulesForm" Grid.Row="1">
          <Grid.ColumnDefinitions><ColumnDefinition Width="226"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource PanelCard}" Padding="12" VerticalAlignment="Top">
            <StackPanel>
              <TextBlock Text="Тип правила" Margin="0,0,0,5"/>
              <ComboBox x:Name="RuleType" Height="36" Style="{StaticResource RulePicker}" AutomationProperties.Name="Тип правила"/>
              <TextBlock Text="Содержимое" Margin="0,12,0,5"/>
              <TextBox x:Name="RuleValue" Height="38" MaxLength="512" Style="{StaticResource CodeField}" AutomationProperties.Name="Содержимое правила"/>
              <TextBlock Text="Действие" Margin="0,12,0,5"/>
              <ComboBox x:Name="RuleAction" Height="36" Style="{StaticResource RulePicker}" AutomationProperties.Name="Действие правила"/>
              <Button x:Name="AddRuleFirst" Content="Добавить в начало" Style="{StaticResource GoldButton}" Margin="0,14,0,6"/>
              <Button x:Name="AddRuleLast" Content="Добавить в конец" Style="{StaticResource ControlButton}"
                      Background="{DynamicResource Inset}" BorderBrush="{DynamicResource Line}"/>
              <TextBlock Text="Первое совпадение определяет маршрут." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,12,0,0"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource PanelCard}" Padding="12">
            <DockPanel>
              <TextBox x:Name="RuleSearch" DockPanel.Dock="Top" Height="38" Style="{StaticResource CodeField}" Margin="0,0,0,8"
                       AutomationProperties.Name="Поиск по правилам" AutomationProperties.HelpText="Условия фильтрации"/>
              <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                <StackPanel x:Name="RuleRows"/>
              </ScrollViewer>
            </DockPanel>
          </Border>
        </Grid>
        <Border x:Name="RulesRawPanel" Grid.Row="1" Style="{StaticResource PanelCard}" Padding="12" Visibility="Collapsed">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="По одному правилу на строку. Формат: ТИП,ЗНАЧЕНИЕ,ДЕЙСТВИЕ" Style="{StaticResource MutedText}"
                       TextWrapping="Wrap" Margin="0,0,0,8"/>
            <TextBox x:Name="RulesRaw" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" MaxLength="55000" Padding="8" FontFamily="Consolas"
                     Background="{DynamicResource Inset}" Foreground="{DynamicResource Text}" BorderBrush="{DynamicResource Line}"
                     AutomationProperties.Name="Правила текстом"/>
          </DockPanel>
        </Border>
        <StackPanel Grid.Row="2" Margin="0,9,0,0">
          <TextBlock x:Name="RulesNotice" Style="{StaticResource MutedText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,7,0,0">
            <Button x:Name="ApplyRules" Content="Применить сейчас" Style="{StaticResource GoldButton}" Margin="0,0,8,0" Visibility="Collapsed"/>
            <Button x:Name="CancelRules" Content="Отмена" Style="{StaticResource ControlButton}"
                    Background="{DynamicResource Inset}" BorderBrush="{DynamicResource Line}" Margin="0,0,8,0"/>
            <Button x:Name="SaveRules" Content="Сохранить" Style="{StaticResource GoldButton}"/>
          </StackPanel>
        </StackPanel>
      </Grid>
